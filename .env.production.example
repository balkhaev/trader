# Public hostname with DNS pointing to the production host.
DOMAIN=trader.example.com
PUBLIC_URL=https://trader.example.com

# PostgreSQL
POSTGRES_DB=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application secrets
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters

# Strategy runtime
STRATEGY_SCHEDULER_ENABLED=true
# Keep false until Binance Futures Testnet and forward validation are complete.
ALLOW_LIVE_TRADING=false

# Optional notifications
TELEGRAM_BOT_TOKEN=

# Published images. Pin SHA tags for deterministic rollouts when desired.
SERVER_IMAGE=ghcr.io/balkhaev/trader-server:latest
WEB_IMAGE=ghcr.io/balkhaev/trader-web:latest
